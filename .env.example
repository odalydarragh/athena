# DocuMDR v1 does not read environment variables and does not call GitHub,
# GitLab, Jira, or any other network service.
#
# Do not put real tokens, client secrets, or patient data in this file.
# A future cloud mode must not be enabled until a data-processing agreement
# and EU hosting decision exist. Leave every value empty in git.

# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=
# DATABASE_URL=
