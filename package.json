{
  "name": "documdr",
  "version": "0.1.0",
  "private": true,
  "description": "DocuMDR — developer-first continuous regulatory integration for SaMD",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 3000 --hostname 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli/documdr.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
