# DocuMDR / Athena — comprehensive ignore list
# Composed from GitHub official templates (Node, Next.js, Python, Docker)
# plus secrets, tenant data, OS, and IDE rules. Never commit credentials.

###############################################################################
# Secrets, credentials, keys, certificates (GDPR Art. 32 / security hygiene)
###############################################################################
.env
.env.*
!.env.example
!.env*.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub
*.ppk
*.kdbx
*.ovpn
*.mobileprovision
*.p8
*.p7b
*.p7c
secrets.*
!secrets.example.*
credentials.json
**/credentials.json
serviceAccountKey.json
*-firebase-adminsdk*.json
GoogleService-Info.plist
google-services.json
.npmrc
!.npmrc.example
.netrc
.pypirc
.pgpass
.htpasswd
.htaccess
*.secret
*.secrets
auth.json
.docker/config.json
.aws/
.azure/
.gcloud/
.gcp/
.kube/config
kubeconfig
.terraform.tfstate
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
*.tfplan
crash.log
crash.*.log
.terraform/
.terraformrc
terraform.rc

###############################################################################
# DocuMDR tenant data, local stores, uploads (processor data — do not commit)
###############################################################################
/data/
/data/**
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal
*.db-wal
*.db-shm
uploads/
tmp/uploads/
var/lib/
backups/
*.dump
*.sql.gz

