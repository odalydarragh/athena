# DocuMDR — secrets, customer data, and local regulatory stores never belong in git.
# .env.example is the only env file that may be committed, and it must stay empty of secrets.

# --- Credentials, keys, and tokens ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.p8
*.jks
*.keystore
*.kdbx
*.crt
*.cer
*.der
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
*.ppk
.npmrc
.pypirc
.pypirc.*
auth.json
.netrc
_netrc
*.credentials
credentials.json
credentials.yml
credentials.yaml
service-account*.json
*-service-account.json
client_secret*.json
oauth-token*
*token.json
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
secrets/
secrets.*
*.secret
*.secrets
.secrets/

# Cloud, CI, and kube credential files
.aws/
.azure/
.gcloud/
.kube/
*.kubeconfig
.docker/config.json
.vercel/
.netlify/
.sentryclirc

# Terraform and IaC state (often contains secrets and infrastructure identifiers)
.terraform/
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.*
.pulumi/

# --- DocuMDR local stores (approver names, pseudonyms, draft files) ---
.documdr/
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal
exports/
technical-file-export/
*.draft.md
*.draft.json

# --- Clinical, patient, and special-category data ---
*.dcm
*.dicom
*.hl7
*.edf
*.nii
*.nii.gz
phi/
patient-data/
patients/
clinical-data/
ehr-export/
*.bak
*.dump
dump.sql
*.sql.gz
*.ndjson

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
.hypothesis/
.ipynb_checkpoints/

# --- JavaScript / future web client (no trackers in v1; ignore deps anyway) ---
node_modules/
.npm/
.pnpm-store/
.yarn/
jspm_packages/
.next/
.nuxt/
.cache/
*.tsbuildinfo

# --- Other build and runtime debris ---
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo
*~
*.orig
*.rej
target/
vendor/
.gradle/
.idea/
*.iml
.vscode/
!.vscode/extensions.json
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local container overrides frequently carry secrets
docker-compose.override.yml
docker-compose.override.yaml
*.local.yml
*.local.yaml
